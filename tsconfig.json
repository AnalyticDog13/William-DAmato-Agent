{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@william/core": ["packages/core/src/index.ts"],
      "@william/core/*": ["packages/core/src/*"],
      "@william/db": ["packages/db/src/index.ts"],
      "@william/memory": ["packages/memory/src/index.ts"],
      "@william/integrations": ["packages/integrations/src/index.ts"],
      "@william/templates": ["packages/templates/src/index.ts"],
      "@william/worker-site-auditor": ["workers/site-auditor/src/index.ts"],
      "@william/worker-outreach": ["workers/outreach/src/index.ts"],
      "@william/worker-site-builder": ["workers/site-builder/src/index.ts"],
      "@william/worker-billing": ["workers/billing/src/index.ts"],
      "@william/worker-scheduling": ["workers/scheduling/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "workers/*/src/**/*.ts",
    "workers/*/test/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/api/test/**/*.ts"
  ],
  "exclude": ["node_modules", "apps/dashboard"]
}
