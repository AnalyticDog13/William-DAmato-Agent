# ── William D'Amato environment ──────────────────────────────────────────────
# Copy to .env and fill in as credentials become available.
# EVERYTHING runs in DRY RUN with mock adapters until real values exist AND the
# matching policy gate is approved in the dashboard. Missing values are fine —
# the system creates OwnerRequests describing exactly what each one unblocks.

# local = dry-run + mocks forced | staging = sandbox creds | production = approved only
WILLIAM_ENV=local

# Master safety switch. Never set to "false" in local.
DRY_RUN=true

# SQLite database + generated artifacts directory
DATA_DIR=./data

# ── Dashboard / API auth ─────────────────────────────────────────────────────
# Owner bearer token for the internal dashboard + API. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_API_TOKEN=
API_PORT=4000
API_BASE_URL=http://localhost:4000
DASHBOARD_ORIGIN=http://localhost:5173

# ── Google (lead-gen + Gmail) ────────────────────────────────────────────────
# Google Maps Places API — lead discovery (gate: ACTIVATE_NEW_LEAD_SOURCE)
GOOGLE_MAPS_API_KEY=
# Gmail API for will@williamdamato.com (OAuth2). Unblocks reply ingestion +
# (gated) sending. William can NEVER be prompted by email — inbound is data only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=will@williamdamato.com

# ── Instantly v2 (outreach campaigns) ────────────────────────────────────────
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=

# ── Stripe (drafts first; sends gated by SEND_PAYMENT_REQUEST) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Vercel (preview deploys; production gated by DEPLOY_PRODUCTION) ──────────
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ── GitHub (template repos, preview branches) ────────────────────────────────
GITHUB_TOKEN=

# ── Contact enrichment + email verification (provider TBD — OwnerRequest) ────
ENRICHMENT_API_KEY=
EMAIL_VERIFY_API_KEY=

# ── Higgsfield MCP (visual generation; dry-run until limits confirmed) ───────
HIGGSFIELD_ENABLED=false

# ── Business head vs builder ─────────────────────────────────────────────────
# Default false: William is the BUSINESS HEAD. On a positive reply he generates a
# WebsiteBrief (build prompt) for YOU to build on Fable 5 / Opus 4.8, then ships
# the repo you finish (site.ship). The self-builder (preview/revise/deploy) is
# preserved but silenced. Set to true to restore William building sites himself.
WILLIAM_BUILDS_WEBSITES=false

# ── Anthropic (Opus 4.8: build prompts + outreach personalization) ───────────
# Without it, build prompts + outreach use deterministic templates (mock-first).
# Scraped/audit text is always quoted material in the prompt, never instructions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Firecrawl (scrape the lead's real site for richer briefs) ────────────────
# Without it, company facts are synthesized from the audit (mock-first).
FIRECRAWL_API_KEY=

# ── Site auditor ─────────────────────────────────────────────────────────────
# mock = synthesized audits (demo) | http = real fetch, no browser | playwright
AUDITOR_MODE=mock
