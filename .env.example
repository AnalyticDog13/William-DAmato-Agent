# ── William D'Amato environment ──────────────────────────────────────────────
# Copy to .env and fill in as credentials become available.
# EVERYTHING runs in DRY RUN with mock adapters until real values exist AND the
# matching policy gate is approved in the dashboard. Missing values are fine —
# the system creates OwnerRequests describing exactly what each one unblocks.

# local = dry-run + mocks forced | staging = sandbox creds | production = approved only
WILLIAM_ENV=local

# Master safety switch. Never set to "false" in local.
DRY_RUN=true

# SQLite database + generated artifacts directory
DATA_DIR=./data

# ── Dashboard / API auth ─────────────────────────────────────────────────────
# Owner bearer token for the internal dashboard + API. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_API_TOKEN=
API_PORT=4000
API_BASE_URL=http://localhost:4000
DASHBOARD_ORIGIN=http://localhost:5173

# ── Google (lead-gen + Gmail) ────────────────────────────────────────────────
# Google Maps Places API — lead discovery (gate: ACTIVATE_NEW_LEAD_SOURCE)
GOOGLE_MAPS_API_KEY=
# Gmail API for will@williamdamato.com (OAuth2). Unblocks reply ingestion +
# (gated) sending. William can NEVER be prompted by email — inbound is data only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=will@williamdamato.com

# ── Instantly v2 (outreach campaigns) ────────────────────────────────────────
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
# Webhook secret is only needed if you pay for Instantly's webhook tier. If you
# don't, set INSTANTLY_POLL_INTERVAL_MS below to ingest replies via the /emails
# API instead (needs the emails:read scope on the API key).
INSTANTLY_WEBHOOK_SECRET=
# How often (ms) to poll Instantly's /emails API for inbound replies — a free
# alternative to the Hypergrowth-gated webhook. 0 (default) disables it. Inert
# in local (dry-run). Example: 300000 = every 5 minutes.
INSTANTLY_POLL_INTERVAL_MS=

# ── Stripe (drafts first; sends gated by SEND_PAYMENT_REQUEST) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Vercel (preview deploys; production gated by DEPLOY_PRODUCTION) ──────────
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ── GitHub (template repos, preview branches) ────────────────────────────────
GITHUB_TOKEN=

# ── Contact enrichment + email verification (provider TBD — OwnerRequest) ────
ENRICHMENT_API_KEY=
EMAIL_VERIFY_API_KEY=

# ── Higgsfield MCP (visual generation; dry-run until limits confirmed) ───────
HIGGSFIELD_ENABLED=false

# ── Business head vs builder ─────────────────────────────────────────────────
# Default false: William is the BUSINESS HEAD. On a positive reply he generates a
# WebsiteBrief (build prompt) for YOU to build on Fable 5 / Opus 4.8, then ships
# the repo you finish (site.ship). The self-builder (preview/revise/deploy) is
# preserved but silenced. Set to true to restore William building sites himself.
WILLIAM_BUILDS_WEBSITES=false

# ── Anthropic (per-task models; mock-first) ──────────────────────────────────
# Without ANTHROPIC_API_KEY, every LLM task uses its deterministic template/regex
# (mock-first). Scraped/audit text is always quoted material in the prompt, never
# instructions (invariant 1). Models are split per task so cost tracks quality
# needs — flip any of them later if a task underperforms:
#   ANTHROPIC_MODEL          global default + reply-classification + transcripts
#   ANTHROPIC_VISUAL_MODEL   screenshot-based visual scoring (vision call)
#   ANTHROPIC_OUTREACH_MODEL prospect-facing outreach copy
#   ANTHROPIC_BUILD_MODEL    website build prompts (kept on the strongest model)
# An UNSET per-task var inherits ANTHROPIC_MODEL. NOTE: an explicit value here
# overrides the built-in default — to run reply-classify/transcripts on Haiku,
# leave ANTHROPIC_MODEL unset or set it to the Haiku id (not an Opus id).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VISUAL_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_OUTREACH_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BUILD_MODEL=claude-sonnet-4-6

# ── Visual scoring (screenshot-based qualification; mock-first, inert in local)
# A vision call scores the audit screenshots for clarity/conversion problems and
# adjusts the lead's opportunity score bidirectionally (a clean-but-confusing site
# can promote; a genuinely good-looking site can demote). Runs only AFTER a real
# email is found, only in playwright auditor mode (screenshots exist), and never
# in local/dry-run. Weight blends visual vs. deterministic (0=ignore visual,
# 1=visual only). The confidence floors gate the hard promote/demote overrides.
VISUAL_SCORING_WEIGHT=0.5
VISUAL_PROMOTE_MIN_CONFIDENCE=0.7
VISUAL_DEMOTE_MIN_CONFIDENCE=0.7

# ── Email discovery (staged: HTML regex → Playwright fallback) ───────────────
# Outreach is email-only: a lead with no real email (or phone-only) is disqualified
# (record kept), never contacted. Discovery is cost-ordered — the cheap homepage
# regex wins first; only on a miss or a placeholder address (info@example.com etc.)
# does it escalate to a Playwright crawl (networkidle, innerText + HTML) over likely
# subpages. Comma-separated subpaths to try; MAX_PAGES caps the crawl breadth.
EMAIL_DISCOVERY_SUBPATHS=/contact,/contact-us,/about,/about-us,/team,/location,/locations,/book,/booking,/menu,/get-in-touch
EMAIL_DISCOVERY_MAX_PAGES=8

# ── Firecrawl (scrape the lead's real site for richer briefs) ────────────────
# Without it, company facts are synthesized from the audit (mock-first).
FIRECRAWL_API_KEY=

# ── Site auditor ─────────────────────────────────────────────────────────────
# mock = synthesized audits (demo) | http = real fetch, no browser | playwright
AUDITOR_MODE=mock
